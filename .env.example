# Çalışma ortamı: development | production
NODE_ENV=production

# Dinlenecek adres ve port (nginx arkasında 127.0.0.1 bırakın)
HOST=127.0.0.1
PORT=3000

# Uygulamanın dışarıdan erişilen tam adresi. Origin denetimi bu adrese göre yapılır.
PUBLIC_URL=https://seyahat.ornek.com.tr

# Ters vekil sayısı ya da Express "trust proxy" değeri (nginx arkasında: 1)
TRUST_PROXY=1

# Üretimde true olmalı: çerez Secure ve __Host- önekli olur
COOKIE_SECURE=true

# Oturum süresi (saat); kullanıcı aktifken kayarak uzar
SESSION_HOURS=8

# SQLite veritabanı yolu (proje köküne göre)
DB_PATH=data/seyahat.db
